# === LMoP Flow Simulator - LLM config ===
# Copy file này thành .env, điền key thật.
# File .env KHÔNG được commit (đã trong .gitignore).
#
# Lựa chọn provider (bỏ comment 1 nhóm):

# === OpenAI (GPT) - đơn giản nhất, cần credit ===
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1   # default, không cần set

# === Anthropic Claude (cần proxy OpenAI-compat) ===
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=claude-3-5-haiku-latest
# LLM_BASE_URL=https://your-anthropic-proxy.com/v1

# === Google Gemini (qua OpenAI-compat endpoint) ===
# LLM_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gemini-1.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# === Local free (Ollama - chạy model trên máy) ===
# Cài: https://ollama.ai  →  ollama pull llama3.2  →  ollama serve
# LLM_API_KEY=dummy
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
