# === LMoP Flow Simulator - LLM config ===
# Copy file này thành .env, điền key thật.
# File .env KHÔNG được commit (đã trong .gitignore).
#
# Lựa chọn provider (bỏ comment 1 nhóm):

# === GLM qua Z.ai (bản quốc tế) ===
# Lấy key tại: https://z.ai/settings/apikey
#
# Z.ai có 2 endpoint - code tự detect format:
#   /api/anthropic  → Anthropic format (glm-5.1 FREE qua wrapper Z.ai)
#   /api/paas/v4    → OpenAI format (glm-4.7-flash FREE)
#
# Khuyến nghị: dùng Anthropic endpoint + glm-5.1 (mạnh nhất, free qua Z.ai)

LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=glm-5.1
LLM_BASE_URL=https://api.z.ai/api/anthropic

# Model Z.ai khả dụng:
#   glm-5.1          - flagship (FREE qua /api/anthropic, mạnh nhất)
#   glm-4.6-air      - air (nhẹ, nhanh)
#   glm-4.7-flash    - FREE qua /api/paas/v4 (OpenAI format)

# === GLM qua Zhipu bigmodel.cn (bản Trung Quốc) ===
# LLM_API_KEY=xxxxxxxxxxxxxx.xxxxxxxxxxxxxx
# LLM_MODEL=glm-4-flash
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# === OpenAI (GPT) - cần credit ===
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# === Google Gemini (qua OpenAI-compat endpoint) ===
# LLM_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gemini-1.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# === Local free (Ollama - chạy model trên máy) ===
# Cài: https://ollama.ai  →  ollama pull llama3.2  →  ollama serve
# LLM_API_KEY=dummy
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
