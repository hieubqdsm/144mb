# === LMoP Flow Simulator - LLM config ===
# Copy file này thành .env, điền key thật.
# File .env KHÔNG được commit (đã trong .gitignore).
#
# Lựa chọn provider (bỏ comment 1 nhóm):

# === GLM qua Z.ai (bản quốc tế, khuyến nghị) ===
# Lấy key tại: https://z.ai/settings/apikey
#
# ⚠️ QUAN TRỌNG: Z.ai có 2 endpoint KHÁC NHAU:
#   /api/anthropic  → cho Claude Code (Anthropic format, KHÔNG dùng được ở đây)
#   /api/paas/v4    → cho tool khác (OpenAI format, DÙNG CÁI NÀY)
#
# Code flow_sim dùng OpenAI format (/chat/completions) → PHẢI dùng /api/paas/v4
# Nếu config sai sang /api/anthropic → 404 NOT_FOUND

LLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=glm-4.7-flash
LLM_BASE_URL=https://api.z.ai/api/paas/v4

# Model Z.ai PaaS khả dụng (2025):
#   glm-4.7-flash   - FREE hoàn toàn (khuyến nghị, flagship free)
#   glm-4.5-air     - có free tier
#   glm-4.5         - reasoning (trả phí)
#   glm-5.1         - flagship (limited-time free, nhưng dễ hết balance)

# === GLM qua Zhipu bigmodel.cn (bản Trung Quốc) ===
# LLM_API_KEY=xxxxxxxxxxxxxx.xxxxxxxxxxxxxx
# LLM_MODEL=glm-4-flash
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# === OpenAI (GPT) - cần credit ===
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# === Google Gemini (qua OpenAI-compat endpoint) ===
# LLM_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gemini-1.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# === Local free (Ollama - chạy model trên máy) ===
# Cài: https://ollama.ai  →  ollama pull llama3.2  →  ollama serve
# LLM_API_KEY=dummy
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
