# === LMoP Flow Simulator - LLM config ===
# Copy file này thành .env, điền key thật.
# File .env KHÔNG được commit (đã trong .gitignore).
#
# Lựa chọn provider (bỏ comment 1 nhóm):

# === GLM (Zhipu / Z.ai) - khuyến nghị ===
# Lấy key tại: https://open.bigmodel.cn/usercenter/apikeys
# Note: GLM key có định dạng "xxx.yyy" (2 phần cách bằng dấu chấm)
LLM_API_KEY=xxxxxxxxxxxxxx.xxxxxxxxxxxxxx
LLM_MODEL=glm-4-flash
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Model GLM khả dụng:
#   glm-4-flash      - nhanh, rẻ (khuyến nghị test flow)
#   glm-4-air        - cân bằng
#   glm-4-plus       - chất lượng cao hơn
#   glm-4.5           - mạnh nhất

# === OpenAI (GPT) - cần credit ===
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# === Google Gemini (qua OpenAI-compat endpoint) ===
# LLM_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
# LLM_MODEL=gemini-1.5-flash
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# === Local free (Ollama - chạy model trên máy) ===
# Cài: https://ollama.ai  →  ollama pull llama3.2  →  ollama serve
# LLM_API_KEY=dummy
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
